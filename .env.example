# ==============================================================================
# MONOREPO ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to `.env` and fill in with your local/environment values.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=promo_db
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js + Express + Prisma)
# ------------------------------------------------------------------------------
# Server port for the Express backend
PORT=4000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Database connection string used by Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
# For local host development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/promo_db?schema=public
# For docker-compose network (used inside backend container):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/promo_db?schema=public

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# ------------------------------------------------------------------------------
# Backend API base URL accessible from the browser
VITE_API_URL=http://localhost:4000
# Frontend local dev server port
VITE_PORT=3000
